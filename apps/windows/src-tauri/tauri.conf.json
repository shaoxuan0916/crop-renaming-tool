{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crop Renamer Windows",
  "version": "0.1.0",
  "identifier": "com.yourusername.croprenamer.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crop Renamer",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../resources/bin/windows/cwebp.exe"]
  }
}
